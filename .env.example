FLASK_ENV=development
FLASK_APP=app.py

# PostgreSQL connection string (auto-fallbacks to SQLite backend/inventra_ai.db if PostgreSQL server is offline)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventra_ai

JWT_SECRET_KEY=inventra-ai-jwt-secret-key-2026
SECRET_KEY=inventra-ai-super-secret-key-2026

# Ollama local intelligence endpoint (auto-fallbacks to database-grounded retail engine if offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

UPLOAD_FOLDER=uploads
